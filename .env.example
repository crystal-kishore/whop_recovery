# Server
PORT=3000

# Whop OAuth app credentials (from your Whop developer dashboard)
WHOP_CLIENT_ID=your_whop_client_id
WHOP_CLIENT_SECRET=your_whop_client_secret
WHOP_REDIRECT_URI=https://your-tunnel-or-domain.example.com/auth/whop/callback

# API key used by the @whop/sdk client for server-to-server API calls
# (e.g. managing payments, webhooks, etc. outside the OAuth flow).
WHOP_API_KEY=your_whop_api_key

# Webhook signing secret (from your Whop webhook settings). Used to verify
# incoming webhook requests per the Standard Webhooks spec. Must be a
# base64-encoded value, optionally prefixed with "whsec_".
WHOP_WEBHOOK_SECRET=your_whop_webhook_secret

# SQLite database file location
DATABASE_PATH=./data/whop-recovery.sqlite

# Used only by scripts/simulate-webhook.ts
TEST_SERVER_URL=http://localhost:3000

# --- Discord recovery messaging (primary channel) ---
# Bot token from the Discord Developer Portal
# (https://discord.com/developers/applications): create an application, add
# a Bot, copy its token here. Invite the bot to a test server with the
# "bot" scope and "Send Messages" permission -- Discord only allows bots to
# DM users they share at least one server with.
DISCORD_BOT_TOKEN=your_discord_bot_token

# Used for the in-dashboard "Add our Discord bot to your server" onboarding
# button (src/auth/discordBotInvite.ts). The Application ID from the same
# Discord Developer Portal application as DISCORD_BOT_TOKEN (General
# Information tab). Not a secret by itself, but keep real project IDs out
# of this template file too -- put the real value in .env only.
DISCORD_CLIENT_ID=your_discord_application_id
# Where Discord redirects back after a creator picks a server to add the
# bot to. Must be registered as a valid OAuth2 redirect in the Discord
# Developer Portal (OAuth2 > General) for the same application.
DISCORD_BOT_INVITE_REDIRECT_URI=https://your-tunnel-or-domain.example.com/auth/discord/callback

# --- Email recovery messaging fallback (Resend, last resort) ---
# Used when a failed payment has neither a discord_id nor a customer_phone
# on file, so the recovery reminder falls back to email. Get a key at
# https://resend.com/api-keys (no credit card required for the free tier).
RESEND_API_KEY=your_resend_api_key
# Sender address for recovery emails. Defaults to Resend's shared
# onboarding@resend.dev test sender, which works without verifying a
# domain but is rate-limited and not meant for real production sending -
# verify your own domain in the Resend dashboard before going live.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Shown in recovery messages when a webhook payload doesn't include a
# company name. Defaults to "the team" if unset.
DEFAULT_COMPANY_NAME=Your Company

# Cron expression controlling how often the reminder scheduler checks for
# due 24h/72h follow-up messages. Defaults to every 15 minutes.
REMINDER_CHECK_CRON=*/15 * * * *

# --- Commission billing (Dodo Payments) ---
# This is a separate billing relationship: we charge each *creator* a
# commission on the revenue our tool recovers for them. We never touch the
# original customer payment itself (Whop/manage_url handles that).
#
# API key from Developer > API Keys in the Dodo Payments dashboard
# (https://app.dodopayments.com). A test mode key only works when
# DODO_PAYMENTS_ENVIRONMENT=test_mode.
DODO_PAYMENTS_API_KEY=your_dodo_payments_api_key
# "test_mode" while developing/testing, "live_mode" once you're ready to
# charge real cards. Must match the mode the API key above was created in.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Webhook signing secret from Developer > Webhooks for the endpoint you
# point at POST /webhooks/dodo. Shown on the endpoint's Overview tab.
DODO_PAYMENTS_WEBHOOK_KEY=your_dodo_payments_webhook_key
# Product id (Products tab in the dashboard) used only to authorize the
# recurring billing mandate -- e.g. a $0 "Recovery commission" product. We
# never charge this product's stored price directly; every real commission
# charge uses POST /subscriptions/{id}/charge with our own computed amount,
# via the on-demand subscriptions API.
DODO_BILLING_PRODUCT_ID=your_dodo_product_id
# Where Dodo's hosted checkout redirects the creator back to after they
# approve (or cancel) the payment-method mandate.
DODO_BILLING_RETURN_URL=https://your-tunnel-or-domain.example.com/billing/dodo/return
# Cron expression controlling how often the commission-billing job runs.
# Defaults to weekly, every Sunday at midnight.
BILLING_CHECK_CRON=0 0 * * 0